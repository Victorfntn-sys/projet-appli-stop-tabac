# Production environment template (no secrets)

PORT=3000

# Web Push
VAPID_SUBJECT=mailto:contact@example.com
VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key

# Android App Links (TWA)
TWA_PACKAGE_NAME=com.victorfntn.stoptabac
TWA_SHA256_CERT_FINGERPRINTS=AA:BB:CC:...:ZZ

# Optional webhook for feedback forwarding
FEEDBACK_WEBHOOK_URL=

# Admin keys (use strong, different secrets)
EXPORT_ADMIN_KEY=replace_with_strong_export_key
ADMIN_API_KEY=replace_with_strong_admin_key
