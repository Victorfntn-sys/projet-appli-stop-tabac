# ═══════════════════════════════════════════════════════════════════
# Variable d'environnement pour production (Play Store)
# ═══════════════════════════════════════════════════════════════════

# Port de l'application
PORT=3000

# ───────────────────────────────────────────────────────────────────────
# Web Push (Notifications)
# Génère des clés avec : npm run generate:vapid
# ───────────────────────────────────────────────────────────────────────

VAPID_SUBJECT=mailto:contact@victorfntn.com
VAPID_PUBLIC_KEY=replace_with_your_public_key_from_npm_run_generate_vapid
VAPID_PRIVATE_KEY=replace_with_your_private_key_from_npm_run_generate_vapid

# ───────────────────────────────────────────────────────────────────────
# Android App Links (TWA / Play Store)
# C'est la clé du lien automatique entre l'app Android et la PWA web
# ───────────────────────────────────────────────────────────────────────

# Package name officiel de l'app Android (unique sur Play Store)
TWA_PACKAGE_NAME=com.victorfntn.stoptabac

# Empreinte SHA-256 du certificat de signature (keystore)
# Génère avec : keytool -list -v -keystore release.keystore -alias release-key
# Copie le SHA-256 (format : AA:BB:CC:...)
TWA_SHA256_CERT_FINGERPRINTS=AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99

# ───────────────────────────────────────────────────────────────────────
# Feedback & Analytics (Optional)
# ───────────────────────────────────────────────────────────────────────

# URL webhook pour les retours utilisateurs (Discord, Slack, etc.)
# Exemple Slack : https://hooks.slack.com/services/YOUR/WEBHOOK/URL
FEEDBACK_WEBHOOK_URL=

# ───────────────────────────────────────────────────────────────────────
# Export de données sécurisé (Admin)
# Clé pour télécharger les données agrégées utilisateurs en Excel
# Utilisation : https://votre-app.com/api/user-state/export-all.xlsx?key=YOUR_SECRET
# ───────────────────────────────────────────────────────────────────────

EXPORT_ADMIN_KEY=choose_a_very_strong_secret_key_here_minimum_32_chars

# ═══════════════════════════════════════════════════════════════════
# Déploiement production : Render ou Railway
# Copie ces variables dans ton dashboard Render/Railway
# ═══════════════════════════════════════════════════════════════════
