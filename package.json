{
  "name": "calculateur-economies-tabac",
  "version": "1.0.0",
  "private": true,
  "description": "PWA de suivi d'arret du tabac avec backend Web Push.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "generate:vapid": "node -e \"const webpush=require('web-push');console.log(JSON.stringify(webpush.generateVAPIDKeys(), null, 2));\""
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "web-push": "^3.6.7"
  }
}
