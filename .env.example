# =============================================================================
# CALCULATEUR D'ECONOMIES TABAC — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs.
# Ne committez JAMAIS votre fichier .env réel.
# =============================================================================

# --- Serveur ------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# --- Sécurité sessions --------------------------------------------------------
# OBLIGATOIRE en production. Générez avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si absent, les sessions sont invalides à chaque redémarrage du serveur.
SESSION_SECRET=remplacez-par-une-chaine-aleatoire-longue

# --- Administration -----------------------------------------------------------
# Clé secrète pour /api/admin/* — envoyez-la dans le header x-admin-key
# Générez avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=replace_with_a_strong_secret

# --- Notifications push (VAPID) -----------------------------------------------
# Générez une paire de clés avec : npm run generate:vapid
VAPID_SUBJECT=mailto:contact@example.com
VAPID_PUBLIC_KEY=replace_with_public_key
VAPID_PRIVATE_KEY=replace_with_private_key

# --- Origines autorisées pour l'API -------------------------------------------
# Séparées par virgules. Laissez vide pour same-origin uniquement (recommandé).
# Exemple: https://votre-domaine.com,https://www.votre-domaine.com
ALLOWED_ORIGINS=

# --- Webhook feedback (optionnel) ---------------------------------------------
FEEDBACK_WEBHOOK_URL=

# --- TWA Android (optionnel) --------------------------------------------------
TWA_PACKAGE_NAME=com.victorfntn.stoptabac
TWA_SHA256_CERT_FINGERPRINTS=

# --- Rate limiting (optionnel, valeurs par défaut fournies) -------------------
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_FEEDBACK_MAX_REQUESTS=25
RATE_LIMIT_USER_STATE_MAX_REQUESTS=120
RATE_LIMIT_PUSH_MAX_REQUESTS=300
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_ANALYTICS_MAX_REQUESTS=30
RATE_LIMIT_ADMIN_MAX_REQUESTS=60
